{
  "name": "gestor-expedientes-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {"@tanstack/vue-query": "latest", "electron": "^31.0.0", "pinia": "^2.1.7", "vue": "^3.4.0"},
  "devDependencies": {"@types/node": "^20.14.0", "@vitejs/plugin-vue": "^5.0.0", "autoprefixer": "^10.4.19", "concurrently": "^8.2.2", "cross-env": "^7.0.3", "postcss": "^8.4.38", "tailwindcss": "^3.4.4", "typescript": "^5.4.0", "vite": "^5.2.0", "vue-tsc": "^2.0.0"}
}
